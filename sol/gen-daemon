#!/bin/bash
# /var/www/gs/sol/gen-daemon

set -u
set -o pipefail

# Shared configuration
if [[ ! -r /var/www/gs/sol/.env ]]; then
    echo "Missing configuration: /var/www/gs/sol/.env" >&2
    exit 1
fi

source /var/www/gs/sol/.env

# Shared logger
if [[ ! -r "$SOL_ROOT/init.sh" ]]; then
    echo "Missing shared logger: $SOL_ROOT/init.sh" >&2
    exit 1
fi

source "$SOL_ROOT/init.sh"

# Runtime paths derived from shared configuration
BG_DIR="$SOL_ROOT/bg"
PUBLIC_DIR="$ROOT/moon"
SOURCE_DIR="$ROOT/gaia/core"
GEN_BIN="$SOL_ROOT/gen.sh"

WATCH_FLAG="$SOL_ROOT/.watch_enabled"
POLL_INTERVAL=10
VERSION_STEP="0.001"

mkdir -p "$LOG_DIR" "$BG_DIR"

log() {
    log_action "GEND: ${1:-}"
}

die() {
    log "FATAL: $1"
    echo "FATAL: $1" >&2
    exit 1
}

# ---------- Version ----------

get_current_version() {
    mariadb -N -B \
        -u "$DB_USER" -p"$DB_PASS" \
        -h "$DB_HOST" -D "$DB_NAME" \
        -e "SELECT val FROM gen_admin.globs WHERE name='GEN_VERSION' LIMIT 1;" \
        2>/dev/null
}

update_version_in_db() {
    local q
    q="UPDATE gen_admin.globs SET val='$1' WHERE name='GEN_VERSION';"

    mariadb \
        -u "$DB_USER" -p"$DB_PASS" \
        -h "$DB_HOST" -D "$DB_NAME" \
        -e "$q" 2>/dev/null ||
    {
        log "ERROR: DB update failed for version $1"
        return 1
    }
}

increment_version() {
    local current
    current=$(get_current_version) || current=""

    if [[ -z "$current" || "$current" == "NULL" ]]; then
        log "GEN_VERSION not found, setting to 0.001"
        update_version_in_db "0.001" &&
            log "Version -> 0.001"
        return
    fi

    local nv

    if command -v bc >/dev/null 2>&1; then
        nv=$(echo "$current + $VERSION_STEP" | bc -l)
    else
        nv=$(awk -v c="$current" -v s="$VERSION_STEP" \
            'BEGIN {printf "%.3f", c+s}')
    fi

    log "GEN_VERSION: $current -> $nv"

    update_version_in_db "$nv" ||
        log "WARN: version update failed"
}

# ---------- Background Services ----------

declare -A SERVICE_PIDS=()
declare -A SERVICE_SCRIPTS=()

start_service() {
    local script="$1"
    local name
    name=$(basename "$script" .sh)

    if [[ -n "${SERVICE_PIDS[$name]:-}" ]] &&
       kill -0 "${SERVICE_PIDS[$name]}" 2>/dev/null; then
        log "$name already running (PID ${SERVICE_PIDS[$name]}), skipping"
        return 0
    fi

    nohup "$script" >> "$LOG_DIR/${name}.log" 2>&1 &

    SERVICE_PIDS["$name"]=$!
    SERVICE_SCRIPTS["$name"]="$script"

    log "Started $name (PID: ${SERVICE_PIDS[$name]})"
}

start_services() {
    local found=0
    local script

    for script in "$BG_DIR"/*.sh; do
        [[ -e "$script" ]] || continue

        if [[ ! -x "$script" ]]; then
            log "WARN: $script not executable, skipping"
            continue
        fi

        start_service "$script"
        found=$((found + 1))
    done

    [[ "$found" -gt 0 ]] ||
        log "WARN: No executables in $BG_DIR"

    increment_version
}

stop_services() {
    log "Stopping background services"

    local name
    local pid

    for name in "${!SERVICE_PIDS[@]}"; do
        pid="${SERVICE_PIDS[$name]}"

        if kill -0 "$pid" 2>/dev/null; then
            log "Stopping $name (PID $pid)"
            kill -TERM "$pid" 2>/dev/null || true
        fi
    done

    for _ in {1..5}; do
        local alive=0

        for name in "${!SERVICE_PIDS[@]}"; do
            kill -0 "${SERVICE_PIDS[$name]}" 2>/dev/null &&
                alive=1
        done

        [[ "$alive" -eq 0 ]] && break
        sleep 1
    done

    for name in "${!SERVICE_PIDS[@]}"; do
        pid="${SERVICE_PIDS[$name]}"

        if kill -0 "$pid" 2>/dev/null; then
            log "Force killing $name (PID $pid)"
            kill -KILL "$pid" 2>/dev/null || true
        fi
    done

    SERVICE_PIDS=()
    SERVICE_SCRIPTS=()
}

# ---------- Watcher ----------

WATCH_PID=""

stop_watcher() {
    if [[ -n "$WATCH_PID" ]] &&
       kill -0 "$WATCH_PID" 2>/dev/null; then
        log "Stopping watcher (PID: $WATCH_PID)"
        kill -TERM "$WATCH_PID" 2>/dev/null || true
        wait "$WATCH_PID" 2>/dev/null || true
    fi

    WATCH_PID=""
}

process_change() {
    local changed_file="$1"

    case "$changed_file" in
        *.swp|*.swx|*~|*.tmp|*.log|*/.git/*|*/node_modules/*)
            return
            ;;
    esac

    local cfg
    cfg=$("$GEN_BIN" gaia getClassMethods Core\\Traits\\Watch 2>/dev/null) ||
        cfg=""

    local core_folder=""
    local cubos_folder=""

    if command -v jq >/dev/null 2>&1 && [[ -n "$cfg" ]]; then
        core_folder=$(echo "$cfg" | jq -r '.coreFolder // empty' 2>/dev/null)
        cubos_folder=$(echo "$cfg" | jq -r '.cubosFolder // empty' 2>/dev/null)
    fi

    [[ -n "$core_folder" ]] || core_folder="Core"
    [[ -n "$cubos_folder" ]] || cubos_folder="Cubos"

    if [[ "$changed_file" == *"/gaia/$cubos_folder/"* ]]; then
        log "Cubo updated: $changed_file"

        "$GEN_BIN" gaia "${cubos_folder,,}Folder" 2>&1 ||
            log "ERROR: Cubos folder update failed"

    elif [[ "$changed_file" == *"/gaia/$core_folder/"* ]]; then
        log "Gaia updated: $changed_file"

        "$GEN_BIN" gaia "${core_folder,,}Folder" 2>&1 ||
            log "ERROR: Core folder update failed"
    fi
}

start_watcher() {
    if ! command -v inotifywait >/dev/null 2>&1; then
        log "WARN: inotifywait not installed, watcher disabled"
        return
    fi

    log "Starting watcher on $PUBLIC_DIR, $SOURCE_DIR"

    (
        inotifywait -m -r -e modify,create,delete \
            --exclude '(\.sw[px]|\~$|\.tmp$|\.log$|/\.git/|/node_modules/)' \
            "$PUBLIC_DIR" "$SOURCE_DIR" \
            --format '%w%f' 2>&1 |
        while read -r f; do
            process_change "$f"
        done
    ) &

    WATCH_PID=$!
    log "Watcher started (PID: $WATCH_PID)"
}

# ---------- Signals ----------

SHUTDOWN=0

cleanup() {
    SHUTDOWN=1

    trap - TERM INT HUP

    log "Received shutdown signal"

    stop_watcher
    stop_services

    log "GEND exiting"
    exit 0
}

trap cleanup TERM INT HUP

# ---------- Main ----------

log "=== GEND starting (PID $$) ==="

start_services

if [[ -f "$WATCH_FLAG" ]]; then
    start_watcher
else
    log "Watcher disabled"
fi

while [[ "$SHUTDOWN" -eq 0 ]]; do

    while [[ "$SHUTDOWN" -eq 0 ]]; do

        # 1. Background process monitoring
        for name in "${!SERVICE_PIDS[@]}"; do
            pid="${SERVICE_PIDS[$name]}"

            if ! kill -0 "$pid" 2>/dev/null; then
                log "Service $name (PID $pid) crashed, restarting"

                local_script="${SERVICE_SCRIPTS[$name]:-$BG_DIR/$name.sh}"

                unset 'SERVICE_PIDS[$name]'
                unset 'SERVICE_SCRIPTS[$name]'

                if [[ -x "$local_script" ]]; then
                    start_service "$local_script"
                else
                    log "ERROR: Cannot restart $name: $local_script not executable"
                fi
            fi
        done

        # 2. System health monitoring
        check_systems

        # 3. Next cycle
        sleep "$POLL_INTERVAL"

    done

    sleep "$POLL_INTERVAL"
done