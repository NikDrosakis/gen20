#!/usr/bin/env bash
# SOL - GEN20 language environment.
# Native interactive Bash is the execution shell.
# SOL adds domain expressions.

if [[ ${SOL_ENGINE:-0} != 1 ]]; then
    export SOL_ENGINE=1
    if (($#)); then
        exec bash "$0" "$@"
    fi
    exec bash --noprofile --rcfile "$0" -i
fi

unset SOL_ENGINE

SOL_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
SOL_ROOT=$(cd -- "$SOL_DIR/.." && pwd -P)
SOL_VERSION="0.1.0"

# --------------------------------------------------
# GEN20 CENTRAL LOG
# --------------------------------------------------

export GEN_LOG_FILE="${GEN_LOG_FILE:-${SOL_ROOT}/data/gen20.net/gen.txt}"
export GEN_LOG_DIR
GEN_LOG_DIR=$(dirname -- "$GEN_LOG_FILE")

if ! mkdir -p -- "$GEN_LOG_DIR"; then
    printf 'SOL: cannot create log directory: %s\n' "$GEN_LOG_DIR" >&2
fi

log_action() {
    local msg="${1:-}"
    local src="${BASH_SOURCE[1]:-${BASH_SOURCE[0]}}"
    local line="${BASH_LINENO[0]:-0}"
    local file timestamp entry

    file=$(basename -- "$src")
    timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    entry="[$timestamp] [$file:$line] $msg"

    if ! printf '%s\n' "$entry" >> "$GEN_LOG_FILE"; then
        printf 'SOL: cannot write central log: %s\n' "$GEN_LOG_FILE" >&2
        return 1
    fi

    printf '%s\n' "$entry"
}

SOL_PROMPT='gen> '
declare -gA SOL_LOADED=()

# Preserve the developer's Bash environment.
if [[ $- == *i* && -r ${HOME}/.bashrc ]]; then
    # shellcheck source=/dev/null
    source "${HOME}/.bashrc"
fi

# --------------------------------------------------
# ENTITY DISCOVERY
# --------------------------------------------------

__sol_entity_file() {
    local name="${1:-}"
    local file

    [[ -n $name ]] || return 1

    for file in \
        "$SOL_DIR/systems/$name.sh" \
        "$SOL_DIR/systems/"*/"$name.sh" \
        "$SOL_DIR/actions/$name.sh" \
        "$SOL_DIR/actions/"*/"$name.sh" \
        "$SOL_DIR/opus/$name.sh"
    do
        if [[ -f $file ]]; then
            printf '%s\n' "$file"
            return 0
        fi
    done

    return 1
}

__sol_entities() {
    local dir file

    for dir in \
        "$SOL_DIR/systems" \
        "$SOL_DIR/actions" \
        "$SOL_DIR/opus"
    do
        [[ -d $dir ]] || continue

        while IFS= read -r -d '' file; do
            basename -- "$file" .sh
        done < <(
            command find "$dir" -type f -name '*.sh' -print0 2>/dev/null
        )
    done | sort -u
}

__sol_load() {
    local file="${1:-}"

    [[ -n $file && -f $file ]] || return 1
    [[ -n ${SOL_LOADED[$file]+loaded} ]] && return 0

    # Expression files must define functions only.
    # shellcheck source=/dev/null
    source "$file" || return 1

    SOL_LOADED[$file]=1
}

__sol_verbs() {
    local name="${1:-}"
    local file fn

    file=$(__sol_entity_file "$name") || return 0
    __sol_load "$file" || return 1

    while IFS= read -r fn; do
        printf '%s\n' "${fn#${name}_}"
    done < <(compgen -A function "${name}_" | sort -u)
}

# --------------------------------------------------
# HELP
# --------------------------------------------------

__sol_help() {
    cat <<'SOLHELP'
SOL language environment

  <system> esti [args...]      inspect a system
  <system> <verb> [args...]    execute a system expression
  <native Bash command>        execute Bash/Linux directly

Examples:

  god esti
  moon esti
  preflight run
  preflight latest
  preflight history
  find . -type f -name '*.php' | grep api
  opus neo

Tab completes SOL expressions and falls back to native Bash completion.
Enter executes. Ctrl-D exits.
Native Bash syntax remains available.
SOLHELP
}

# --------------------------------------------------
# DISPATCH
# --------------------------------------------------

__sol_dispatch() {
    (($#)) || return 0

    local name="$1"
    local verb file fn candidate
    local found=0

    shift

    case "$name" in
        help)
            __sol_help
            return 0
            ;;
        version)
            printf 'SOL %s\n' "$SOL_VERSION"
            return 0
            ;;
        opus)
            case "${1:-esti}" in
                esti)
                    printf 'OPUS expression space - ASTRA packaging integration follows.\n'
                    ;;
                neo|sose)
                    printf 'OPUS %s - reserved expression; provider not connected yet.\n' "$1"
                    return 2
                    ;;
                *)
                    printf 'OPUS expressions: esti neo sose\n'
                    ;;
            esac
            return 0
            ;;
    esac

    file=$(__sol_entity_file "$name") || return 127
    __sol_load "$file" || return 1

    verb="${1:-esti}"
    (($#)) && shift

    fn="${name}_${verb}"

    if declare -F "$fn" >/dev/null 2>&1; then
        "$fn" "$@"
        return $?
    fi

    printf 'SOL: %s has no expression "%s". Available:' \
        "$name" "$verb" >&2

    while IFS= read -r candidate; do
        printf ' %s' "$candidate" >&2
        found=1
    done < <(__sol_verbs "$name")

    ((found)) || printf ' (none)' >&2
    printf '\n' >&2

    return 2
}

# --------------------------------------------------
# NATIVE BASH FALLBACK
# --------------------------------------------------

command_not_found_handle() {
    local name="${1:-}"

    shift || true

    if __sol_entity_file "$name" >/dev/null 2>&1 ||
       [[ $name == opus || $name == help || $name == version ]]
    then
        __sol_dispatch "$name" "$@"
        return $?
    fi

    printf 'bash: %s: command not found (try: help)\n' "$name" >&2
    return 127
}

# --------------------------------------------------
# COMPLETION
# --------------------------------------------------

_sol_complete() {
    local cur="" name="" file="" verbs="" words=""

    COMPREPLY=()

    [[ ${COMP_WORDS+x} && ${COMP_CWORD+x} ]] || return 0
    ((${#COMP_WORDS[@]} > 0)) || return 0
    ((COMP_CWORD >= 0 && COMP_CWORD < ${#COMP_WORDS[@]})) || return 0

    cur="${COMP_WORDS[COMP_CWORD]}"

    if ((COMP_CWORD == 0)); then
        words="$(__sol_entities) help version opus"
        mapfile -t COMPREPLY < <(compgen -W "$words" -- "$cur")
        return 0
    fi

    name="${COMP_WORDS[0]}"

    if [[ $name == opus ]]; then
        mapfile -t COMPREPLY < <(
            compgen -W 'esti neo sose' -- "$cur"
        )
        return 0
    fi

    file=$(__sol_entity_file "$name" 2>/dev/null) || return 0
    verbs=$(__sol_verbs "$name")

    mapfile -t COMPREPLY < <(compgen -W "$verbs" -- "$cur")
    return 0
}

# Load system-wide Bash completion when available.
if [[ -r /usr/share/bash-completion/bash_completion ]] &&
   ! declare -F _completion_loader >/dev/null 2>&1
then
    # shellcheck source=/dev/null
    source /usr/share/bash-completion/bash_completion
fi

complete -D -F _sol_complete -o bashdefault -o default

# --------------------------------------------------
# HISTORY AND PROMPT
# --------------------------------------------------

HISTFILE="${GEN_HISTORY:-${HOME}/.gen_history}"
HISTSIZE=5000
HISTFILESIZE=10000
HISTCONTROL=ignoredups:erasedups

shopt -s histappend
set -o history

PS1="$SOL_PROMPT"

# --------------------------------------------------
# INTERACTIVE MODE
# --------------------------------------------------

if [[ $- == *i* ]]; then
    printf 'SOL %s | GEN20 language environment\n' "$SOL_VERSION"
    printf 'Type help for expressions. Native Bash is available.\n'
    return 0 2>/dev/null || exit 0
fi

# --------------------------------------------------
# SCRIPT / COMMAND MODE
# --------------------------------------------------

if (($#)); then
    if [[ $1 == -c || $1 == --command ]]; then
        shift
        eval "$*"
        exit $?
    fi

    if __sol_entity_file "$1" >/dev/null 2>&1 ||
       [[ $1 == opus || $1 == help || $1 == version ]]
    then
        __sol_dispatch "$@"
    else
        command "$@"
    fi

    exit $?
fi
