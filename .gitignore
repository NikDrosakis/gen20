# ==================================================
# GEN20
# Git exclusions
# ==================================================

# Environment and secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# IDE and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db

# Git-local files
*.swp
*.swo
*~

# ==================================================
# Dependencies
# ==================================================

**/node_modules/
**/vendor/
.yarn/
kronos/genenv/

# ==================================================
# Python
# ==================================================

**/__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# ==================================================
# Logs and runtime files
# ==================================================

*.log
log/

# ==================================================
# Generated builds and binaries
# ==================================================

dist/
build/
**/target/

# ==================================================
# Temporary and legacy directories
# ==================================================

**/old/
god/tmp/
mars/tmp2/

# ==================================================
# GEN20 specific exclusions
# ==================================================

setup/
kronos/services/sketch/video/
mars/server

# Symfony private production key
config/secrets/prod/prod.decrypt.private.php

# PHPUnit
.phpunit.result.cache

# Database dumps (not SQL source/migrations)
*.dump.sql
*.backup.sql
*.sql.gz

# Archives
*.zip
