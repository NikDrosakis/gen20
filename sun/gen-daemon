#!/bin/bash
# /var/www/gs/sun/gen-daemon

set -u
set -o pipefail

# ---------- Config ----------
ROOT="/var/www/gs"
SUN_DIR="$ROOT/sun"
ENV_FILE="$ROOT/.env"
BG_DIR="$SUN_DIR/bg"                    # ✅ sun/bg
LOG_DIR="$ROOT/log"
PUBLIC_DIR="$ROOT/moon"
SOURCE_DIR="$ROOT/gaia/core"
GEN_BIN="$SUN_DIR/gen.sh"
WATCH_FLAG="$SUN_DIR/.watch_enabled"
POLL_INTERVAL=10
VERSION_STEP="0.001"

mkdir -p "$LOG_DIR"

# ---------- Logs ----------
# 1. gen-daemon.log (internal)
# 2. gen.txt (actions — προσβάσιμο από https://gen20.net/data/gen.txt)
GEN_LOG_FILE="$ROOT/data/gen20.net/gen.txt"
GEN_LOG_DIR="$(dirname "$GEN_LOG_FILE")"
mkdir -p "$GEN_LOG_DIR" 2>/dev/null || true

log() {
    local msg="$1"
    local src="${BASH_SOURCE[1]:-${BASH_SOURCE[0]}}"
    local line="${BASH_LINENO[0]:-0}"
    local file
    file=$(basename "$src")
    local ts
    ts=$(date '+%Y-%m-%d %H:%M:%S')

    # Γράφει και στα δύο logs
    echo "[$ts] [$file:$line] $msg" >> "$LOG_DIR/gen-daemon.log"
    echo "[$ts] [$file:$line] $msg" >> "$GEN_LOG_FILE"
}

die() {
    log "FATAL: $1"
    echo "FATAL: $1" >&2
    exit 1
}

# ---------- ENV ----------
[ -f "$ENV_FILE" ] || die "Missing .env file: $ENV_FILE"
# shellcheck disable=SC1090
source "$ENV_FILE" || die "Failed to source .env"

: "${DB_USER:?DB_USER not set in .env}"
: "${DB_PASS:?DB_PASS not set in .env}"
: "${DB_HOST:?DB_HOST not set in .env}"
: "${DB_NAME:?DB_NAME not set in .env}"

HOST_TAG="${host:-gen20.net}"
DATA_DIR="$ROOT/data/$HOST_TAG"
mkdir -p "$DATA_DIR" 2>/dev/null || true

# ---------- Version ----------
get_current_version() {
    mariadb -N -B -u "$DB_USER" -p"$DB_PASS" -h "$DB_HOST" -D "$DB_NAME" \
        -e "SELECT val FROM gen_admin.globs WHERE name='GEN_VERSION' LIMIT 1;" 2>/dev/null
}

update_version_in_db() {
    local q="UPDATE gen_admin.globs SET val='$1' WHERE name='GEN_VERSION';"
    mariadb -u "$DB_USER" -p"$DB_PASS" -h "$DB_HOST" -D "$DB_NAME" -e "$q" 2>/dev/null \
        || { log "ERROR: DB update failed for version $1"; return 1; }
}

increment_version() {
    local current; current=$(get_current_version) || current=""
    if [ -z "$current" ] || [ "$current" = "NULL" ]; then
        log "GEN_VERSION not found, setting to 0.001"
        update_version_in_db "0.001" && log "Version -> 0.001"
        return
    fi
    local nv
    if command -v bc >/dev/null 2>&1; then
        nv=$(echo "$current + $VERSION_STEP" | bc -l)
    else
        nv=$(awk -v c="$current" -v s="$VERSION_STEP" 'BEGIN{printf "%.3f", c+s}')
    fi
    log "GEN_VERSION: $current -> $nv"
    update_version_in_db "$nv" || log "WARN: version update failed"
}

# ---------- Services ----------
declare -A SERVICE_PIDS=()
declare -A SERVICE_SCRIPTS=()

start_service() {
    local script="$1"
    local name; name=$(basename "$script" .sh)
    if [ -n "${SERVICE_PIDS[$name]:-}" ] && kill -0 "${SERVICE_PIDS[$name]}" 2>/dev/null; then
        log "$name already running (PID ${SERVICE_PIDS[$name]}), skipping"
        return 0
    fi
    nohup "$script" >> "$LOG_DIR/${name}.log" 2>&1 &
    SERVICE_PIDS["$name"]=$!
    SERVICE_SCRIPTS["$name"]=$script
    log "Started $name (PID: ${SERVICE_PIDS[$name]})"
}

start_services() {
    local found=0
    for script in "$BG_DIR"/*.sh; do
        [ -e "$script" ] || continue
        [ -x "$script" ] || { log "WARN: $script not executable, skipping"; continue; }
        start_service "$script"
        found=$((found + 1))
    done
    [ "$found" -eq 0 ] && log "WARN: No executables in $BG_DIR"
    increment_version
}

stop_services() {
    log "Stopping all services..."
    for name in "${!SERVICE_PIDS[@]}"; do
        local pid="${SERVICE_PIDS[$name]}"
        kill -0 "$pid" 2>/dev/null && { log "Stopping $name (PID $pid)"; kill -TERM "$pid" 2>/dev/null; }
    done
    for _ in $(seq 1 5); do
        local alive=0
        for name in "${!SERVICE_PIDS[@]}"; do kill -0 "${SERVICE_PIDS[$name]}" 2>/dev/null && alive=1; done
        [ "$alive" -eq 0 ] && break
        sleep 1
    done
    for name in "${!SERVICE_PIDS[@]}"; do
        local pid="${SERVICE_PIDS[$name]}"
        kill -0 "$pid" 2>/dev/null && { log "Force killing $name (PID $pid)"; kill -KILL "$pid" 2>/dev/null; }
    done
    SERVICE_PIDS=()
    SERVICE_SCRIPTS=()
}

# ---------- Watcher ----------
WATCH_PID=""
stop_watcher() {
    if [ -n "$WATCH_PID" ] && kill -0 "$WATCH_PID" 2>/dev/null; then
        log "Stopping watcher (PID: $WATCH_PID)"
        kill -TERM "$WATCH_PID" 2>/dev/null
        wait "$WATCH_PID" 2>/dev/null
    fi
    WATCH_PID=""
}

process_change() {
    local changed_file="$1"
    case "$changed_file" in
        *.swp|*.swx|*~|*.tmp|*.log|*/.git/*|*/node_modules/*) return ;;
    esac

    local cfg
    cfg=$("$GEN_BIN" gaia getClassMethods Core\\Traits\\Watch 2>/dev/null) || cfg=""
    local core_folder cubos_folder
    if command -v jq >/dev/null 2>&1 && [ -n "$cfg" ]; then
        core_folder=$(echo "$cfg" | jq -r '.coreFolder // empty' 2>/dev/null)
        cubos_folder=$(echo "$cfg" | jq -r '.cubosFolder // empty' 2>/dev/null)
    fi
    [ -z "${core_folder:-}" ] && core_folder="Core"
    [ -z "${cubos_folder:-}" ] && cubos_folder="Cubos"

    if [[ "$changed_file" == *"/gaia/$cubos_folder/"* ]]; then
        log "Cubo updated: $changed_file"
        "$GEN_BIN" gaia "${cubos_folder,,}Folder" 2>&1 | tee -a "$GEN_LOG_FILE" \
            || log "ERROR: gen gaia ${cubos_folder,,}Folder failed"
    elif [[ "$changed_file" == *"/gaia/$core_folder/"* ]]; then
        log "Gaia updated: $changed_file"
        "$GEN_BIN" gaia "${core_folder,,}Folder" 2>&1 | tee -a "$GEN_LOG_FILE" \
            || log "ERROR: gen gaia ${core_folder,,}Folder failed"
    fi
}

start_watcher() {
    if ! command -v inotifywait >/dev/null 2>&1; then
        log "WARN: inotifywait not installed, watcher disabled"; return
    fi
    log "Starting watcher on $PUBLIC_DIR, $SOURCE_DIR"
    (
        inotifywait -m -r -e modify,create,delete \
            --exclude '(\.sw[px]|~$|\.tmp$|\.log$|/\.git/|/node_modules/)' \
            "$PUBLIC_DIR" "$SOURCE_DIR" --format '%w%f' 2>>"$LOG_DIR/inotify.err" | \
        while read -r f; do process_change "$f"; done
    ) &
    WATCH_PID=$!
    log "Watcher started (PID: $WATCH_PID)"
}

# ---------- Signals ----------
SHUTDOWN=0
cleanup() {
    SHUTDOWN=1
    log "Received shutdown signal"
    stop_watcher
    stop_services
    log "gen-daemon exiting"
    exit 0
}
trap cleanup TERM INT HUP

# ---------- Main ----------
log "=== gen-daemon starting (PID $$) ==="
start_services

if [ -f "$WATCH_FLAG" ]; then
    start_watcher
else
    log "Watcher disabled (touch $WATCH_FLAG to enable)"
fi

while [ "$SHUTDOWN" -eq 0 ]; do
    for name in "${!SERVICE_PIDS[@]}"; do
        pid="${SERVICE_PIDS[$name]}"
        if ! kill -0 "$pid" 2>/dev/null; then
            log "Service $name (PID $pid) crashed, restarting"
            unset 'SERVICE_PIDS[$name]'
            start_service "${SERVICE_SCRIPTS[$name]:-$BG_DIR/$name.sh}"
        fi
    done
    sleep "$POLL_INTERVAL"
done