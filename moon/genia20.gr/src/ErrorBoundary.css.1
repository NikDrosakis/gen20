/* ErrorBoundary.css */
.error-boundary {
    padding: 4rem 2rem;
}

.error-boundary h1 {
    color: var(--text-h, var(--text, #333));
    margin-bottom: 1rem;
}

.error-boundary p {
    color: var(--text, #666);
    margin-bottom: 1.5rem;
}

.error-boundary button {
    padding: 0.6rem 1.25rem;
    border: none;
    border-radius: 4px;
    background: #ff0000;
    color: #fff;
    cursor: pointer;
    font-weight: 700;
}
