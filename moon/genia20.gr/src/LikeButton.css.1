/* LikeButton.css */
.like-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--border);
    background: var(--bg2, #fff);
    color: var(--text);
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    cursor: pointer;
    font-size: 0.9rem;
    transition: all 0.2s ease;
}

.like-btn:hover {
    border-color: #ff0000;
}

.like-btn.liked {
    border-color: #ff0000;
    background: rgba(255, 0, 0, 0.08);
}

.like-btn.loading {
    opacity: 0.6;
    cursor: not-allowed;
}

.like-icon {
    font-size: 1rem;
}

.like-count {
    font-weight: 700;
}
