:root {
    --X: 1;
    --card-width: calc(var(--X) * 200px);
    --card-margin: calc(var(--X) * 5px);
    --card-p: calc(var(--X) * 1.1em);
    --card-cover-height: calc(var(--X) * 70%);
    --light-header-bg: #f4f1ea;
    --light-a: #000;
    --light-h1: #333;
    --light-bg: #f5f5dc;
    --light-text: #3e3e3e;
    --light-menu-bg: #f4f1ea;
    --light-menu-text: #71400c;
    --light-button-bg: #71400c;
    --light-button-text: #71400c;
    --light-input-bg: #ffffff;
    --light-input-text: #3e3e3e;
    --light-main: #fffef48a;
    --light-sl: #fffef48a;
    --light-a: #71400c;
    --light-h1: #71400c;
    --dark-header-bg: #000;
    --dark-bg: #000;
    --dark-text: #e0e0e0;
    --dark-menu-bg: #000;
    --dark-menu-text: #e0e0e0;
    --dark-button-bg: #71400c;
    --dark-button-text: #ffffff;
    --dark-input-bg: #333333;
    --dark-input-text: #e0e0e0;
    --dark-main: #333;
    --dark-sl: #333;
    --dark-a: #fff;
    --dark-h1: #fff;
}
/* Light mode variables */
.light {
    --h1: var(--light-h1);
    --a: var(--light-a);
    --bg-color: var(--light-bg);
    --text-color: var(--light-text);
    --header-bg: var(--light-header-bg);
    --header-text: var(--light-menu-text);
    --menu-bg: var(--light-menu-bg);
    --menu-text: var(--light-menu-text);
    --button-bg: var(--light-button-bg);
    --button-text: var(--light-button-text);
    --input-bg: var(--light-input-bg);
    --input-text: var(--light-input-text);
    --main: var(--light-main);
    --sl: var(--light-sl);
}
/* Dark mode variables */
.dark {
    --h1: var(--dark-h1);
    --a: var(--dark-a);
    --bg-color: var(--dark-bg);
    --text-color: var(--dark-text);
    --header-bg: var(--dark-header-bg);
    --header-text: var(--dark-text);
    --menu-bg: var(--dark-menu-bg);
    --menu-text: var(--dark-menu-text);
    --button-bg: var(--dark-button-bg);
    --button-text: var(--dark-button-text);
    --input-bg: var(--dark-input-bg);
    --input-text: var(--dark-input-text);
    --main: var(--dark-main);
    --sl: var(--dark-sl);
}
