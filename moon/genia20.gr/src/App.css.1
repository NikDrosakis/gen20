/*----------------------------------------*/
/* Template default CSS
/*----------------------------------------*/
html,
body {
    height: 100%;
}

:root {
    --bg: #ffffff;
    --bgred:rgb(255, 221, 221);
    --bg2: white;
    --bg3: #dbdcc06b;
    --text: #111111;
    --text2: #443b2a;
    --border: darkcyan;
    --shadow: 0 0 12px rgb(179 168 168);
}

[data-theme="dark"] {
    --bg: #111111;
    --bgred: #530101;
    --bg2: #333;
    --bg3: black;
    --text: #f0f0f0;
    --text2: #ad9564;
}

body {
    background-color: var(--bg);
    color: var(--text);
}
button{
    color:var(--text);
}
h1,
h2,
h3,
h4,
h5,
h6 {
    margin: 0;
    font-weight: 400;
    font-family: sans-serif;
}

h1 {
    font-size: 50px;
}

h2 {
    font-size: 36px;
}

h3 {
    font-size: 30px;
}

h4 {
    font-size: 24px;
}

h5 {
    font-size: 18px;
}

h6 {
    font-size: 16px;
}

p {
    font-size: 16px;
    font-family: "Josefin Sans", sans-serif;
    font-weight: 400;
    line-height: 26px;
    margin: 0 0 15px 0;
    color: var(--text);
}

img {
    max-width: 100%;
}

input:focus,
select:focus,
button:focus,
textarea:focus {
    outline: none;
}
a { color:var(--text);}
a:hover,
a:focus {
    text-decoration: none;
    outline: none;
}
li{ color:var(--text);}
ul,
ol {
    padding: 0;
    margin: 0;
}

/* App.css */
.gen-page-body { display: flex; gap: 2rem; align-items: flex-start; }
.gen-area-main { flex: 1; min-width: 0; }
.gen-area-sl, .gen-area-sr { flex: 0 0 20%; min-width: 0; }
/*---------------------
  Helper CSS
-----------------------*/
.bare{
    border:none;
    background:var(--bg);
    color:var(--text);
}
.section-title {
    margin-bottom: 50px;
}
.section-title.center-title {
    text-align: center;
}
.section-title.center-title h2:after {
    right: 0;
    margin: 0 auto;
}
.section-title span {
    color:var(--text);
    display: block;
    font-size: 16px;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 6px;
}
.section-title h2 {
    font-weight: 700;
    position: relative;
    padding-bottom: 25px;
    color: var(--text);
}
.section-title h2:after {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 5px;
    width: 70px;
    background: #ff0000;
    content: "";
}

.set-bg {
    background-repeat: no-repeat;
    background-size: cover;
    background-position: top center;
}

.spad {
    padding-top: 20px;
    padding-bottom: 100px;
}

.text-white h1,
.text-white h2,
.text-white h3,
.text-white h4,
.text-white h5,
.text-white h6,
.text-white p,
.text-white span,
.text-white li,
.text-white a {
    color: var(--text);
}

/* buttons */
.primary-btn {
    display: inline-block;
    font-size: 15px;
    font-family: sans-serif;
    font-weight: 700;
    padding: 14px 32px 12px;
    letter-spacing: 2px;
    position: relative;
    z-index: 1;
}
.primary-btn:hover:before {
    height: 100%;
    width: 100%;
}
.primary-btn:hover:after {
    height: 100%;
    width: 100%;
}
.primary-btn:before {
    position: absolute;
    left: 0;
    top: 0;
    height: 30px;
    width: 30px;
    border-left: 2px solid #ff0000;
    border-top: 2px solid #ff0000;
    content: "";
    z-index: -1;
    -webkit-transition: all, 0.7s;
    -o-transition: all, 0.7s;
    transition: all, 0.7s;
}
.primary-btn:after {
    position: absolute;
    right: 0;
    bottom: 0;
    height: 30px;
    width: 30px;
    border-right: 2px solid #ff0000;
    border-bottom: 2px solid #ff0000;
    content: "";
    z-index: -1;
    -webkit-transition: all, 0.7s;
    -o-transition: all, 0.7s;
    transition: all, 0.7s;
}

.site-btn {
    font-size: 15px;
    color:var(--text);
    background: #ff0000;
    font-family: sans-serif;
    font-weight: 700;
    border: none;
    display: inline-block;
    text-transform: uppercase;
    letter-spacing: 2px;
    padding: 14px 34px 12px;
    width: 100%;
}

/* Preloder */
#preloder {
    position: fixed;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    z-index: 999999;
    background: #000;
}

.loader {
    width: 40px;
    height: 40px;
    position: absolute;
    top: 50%;
    left: 50%;
    margin-top: -13px;
    margin-left: -13px;
    border-radius: 60px;
    animation: loader 0.8s linear infinite;
    -webkit-animation: loader 0.8s linear infinite;
}

@keyframes loader {
    0% {
        -webkit-transform: rotate(0deg);
        transform: rotate(0deg);
        border: 4px solid #f44336;
        border-left-color: transparent;
    }
    50% {
        -webkit-transform: rotate(180deg);
        transform: rotate(180deg);
        border: 4px solid #673ab7;
        border-left-color: transparent;
    }
    100% {
        -webkit-transform: rotate(360deg);
        transform: rotate(360deg);
        border: 4px solid #f44336;
        border-left-color: transparent;
    }
}
@-webkit-keyframes loader {
    0% {
        -webkit-transform: rotate(0deg);
        border: 4px solid #f44336;
        border-left-color: transparent;
    }
    50% {
        -webkit-transform: rotate(180deg);
        border: 4px solid #673ab7;
        border-left-color: transparent;
    }
    100% {
        -webkit-transform: rotate(360deg);
        border: 4px solid #f44336;
        border-left-color: transparent;
    }
}
