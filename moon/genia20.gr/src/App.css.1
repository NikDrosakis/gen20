/*
CORE.CSS
*/

#sidebar-left,#sidebar-right{
    float:left;
    width: 20%;
}
#mainpage2{
    float:left;
    width: 60%;
    min-height: 70%;
}
/* GRID CHANNELS */
#mainpage {
    float: left;
    width: 94%;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr; /* 3 columns by default */
    grid-template-rows: 1fr 1fr; /* 2 rows */
    gap: 0.4%; /* space between grid items */
    height: 95vh;
    box-sizing: border-box;
}

/* On screens smaller than 800px, 2 columns layout (2x2 grid) */
@media screen and (max-width: 800px) {
    #mainpage {
        grid-template-columns: 1fr 1fr; /* 2 columns */
        grid-template-rows: 1fr 1fr; /* 2 rows (4 items in total) */
    }
}

/* On screens smaller than 600px, 1 column layout with 6 rows (each item takes up a row) */
@media screen and (max-width: 600px) {
    #mainpage {
        grid-template-columns: 1fr; /* 1 column */
        grid-template-rows: repeat(6, 1fr); /* 6 rows (each item takes up a row) */
    }
}

#progressBarContainer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 8px; /* Adjust the height as needed */
    background-color: #333333; /* Light gray background */
    z-index: 9999; /* Ensure it's on top of other elements */
}

/* The progress bar itself */
#progressBar {
    width: 0;
    height: 100%;
    background-color: #4caf50; /* Green progress bar */
    transition: width 0.4s ease; /* Smooth transition */
}
#container {
    height: 100vh;
}

