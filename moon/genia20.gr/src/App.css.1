}
.hero__slider.owl-carousel .owl-dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 45px;
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
}
.hero__slider.owl-carousel .owl-dots button {
    color: #adadad;
