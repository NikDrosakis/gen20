    font-size: 15px;
    letter-spacing: 2px;
    margin-bottom: 18px;
    position: relative;
    top: 100px;
    opacity: 0;
    -webkit-transition: all, 0.3s;
    -o-transition: all, 0.3s;
    transition: all, 0.3s;
}
.hero__text h2 {
    color:var(--text);
    font-size: 60px;
    font-weight: 700;
    line-height: 70px;
    margin-bottom: 38px;
    position: relative;
    top: 100px;
    opacity: 0;
