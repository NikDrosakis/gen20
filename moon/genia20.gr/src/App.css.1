/*
SKELETON
*/
/* layouts/Skeleton.css */
.skeleton-container {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

/* Main Layout */
.skeleton-main {
    display: flex;
    flex: 1;
}

/* Sidebar Left */
.skeleton-sidebar-left {
    width: 256px;
    background: var(--bg-secondary, #f8f9fa);
    padding: 16px;
    border-right: 1px solid var(--border-color, #e2e8f0);
}

[data-theme="dark"] .skeleton-sidebar-left {
    background: var(--bg-secondary, #1a1a2e);
    border-right-color: var(--border-color, #2d2d44);
}

/* Sidebar Right */
.skeleton-sidebar-right {
    width: 256px;
    background: var(--bg-secondary, #f8f9fa);
    padding: 16px;
    border-left: 1px solid var(--border-color, #e2e8f0);
}

[data-theme="dark"] .skeleton-sidebar-right {
    background: var(--bg-secondary, #1a1a2e);
    border-left-color: var(--border-color, #2d2d44);
}

/* Main Content */
.skeleton-main-content {
    padding: 24px;
    overflow: auto;
    flex: 1;
}

.skeleton-main-content.w-full {
    width: 100%;
}

.skeleton-main-content.w-4\/5 {
    width: 80%;
}

.skeleton-main-content.w-3\/5 {
    width: 60%;
}

/* Header Components */
.skeleton-header-components {
    width: 100%;
}

/* Footer Components */
.skeleton-footer-components {
    width: 100%;
}

/* Component Wrapper */
.component-wrapper {
    margin-bottom: 8px;
}

.component-item {
    margin-bottom: 16px;
}

/* Component Placeholder */
.component-placeholder {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    background: var(--bg-primary, #ffffff);
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 6px;
    font-size: 14px;
    color: var(--text-secondary, #475569);
}

[data-theme="dark"] .component-placeholder {
    background: var(--bg-primary, #1a1a2e);
    border-color: var(--border-color, #2d2d44);
    color: var(--text-secondary, #94a3b8);
}

.component-icon {
    font-size: 18px;
}

.component-name {
    font-weight: 500;
    color: var(--text-primary, #1a1a2e);
}

[data-theme="dark"] .component-name {
    color: var(--text-primary, #f1f5f9);
}

.component-desc {
    font-size: 12px;
    color: var(--text-secondary, #64748b);
    margin-left: 4px;
}

/* Loading State */
.skeleton-loading {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

.skeleton-loading-center {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
}

.loading-spinner {
    color: var(--text-secondary, #64748b);
    font-size: 16px;
}

/* Responsive */
@media (max-width: 768px) {
    .skeleton-sidebar-left,
    .skeleton-sidebar-right {
        width: 100%;
        border-right: none;
        border-left: none;
        border-bottom: 1px solid var(--border-color, #e2e8f0);
    }

    .skeleton-main {
        flex-direction: column;
    }

    .skeleton-main-content.w-full,
    .skeleton-main-content.w-4\/5,
    .skeleton-main-content.w-3\/5 {
        width: 100%;
    }

    .skeleton-sidebar-right {
        border-top: 1px solid var(--border-color, #e2e8f0);
    }
}

