/* GRID CHANNELS */
#mainpage {
    float: left;
    width: 94%;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr; /* 3 columns by default */
    grid-template-rows: 1fr 1fr; /* 2 rows */
    gap: 0.4%; /* space between grid items */
    height: 95vh;
    box-sizing: border-box;
}

/* On screens smaller than 800px, 2 columns layout (2x2 grid) */
@media screen and (max-width: 800px) {
    #mainpage {
        grid-template-columns: 1fr 1fr; /* 2 columns */
        grid-template-rows: 1fr 1fr; /* 2 rows (4 items in total) */
    }
}

/* On screens smaller than 600px, 1 column layout with 6 rows (each item takes up a row) */
@media screen and (max-width: 600px) {
    #mainpage {
        grid-template-columns: 1fr; /* 1 column */
        grid-template-rows: repeat(6, 1fr); /* 6 rows (each item takes up a row) */
    }
}


/* Channel styles */
.channel {
    padding: 10px;
    border: 1px solid #d7d7d7;
    border-radius: 10px;
    background-color: white;
    overflow: auto;
    position: relative; /* Needed for resize handles */
}

.top-left {
    grid-column: 1 / span 1;
    grid-row: 1 / span 1;
}

.top-right {
    grid-column: 2 / span 1;
    grid-row: 1 / span 1;
}

.bottom-left {
    grid-column: 1 / span 1;
    grid-row: 2 / span 1;
}

.bottom-right {
    grid-column: 2 / span 1;
    grid-row: 2 / span 1;
}

.resizable {
    resize: both;
    overflow: auto;
    zoom:0.8;
}
.resize-handle {
    position: absolute;
    width: 10px;
    height: 10px;
    background: gray;
    z-index: 10;
}
.resize-handle.bottom-right {
    bottom: 0;
    right: 0;
    cursor: se-resize;
}
.resize-handle.bottom-left {
    bottom: 0;
    left: 0;
    cursor: sw-resize;
}        .resize-handle.bottom-center {
             bottom: 0;
             right: 0;
             cursor: se-resize;
         }
.resize-handle.top-center {
    bottom: 0;
    left: 0;
    cursor: sw-resize;
}
.resize-handle.top-right {
    top: 0;
    right: 0;
    cursor: ne-resize;
}
.resize-handle.top-left {
    top: 0;
    left: 0;
    cursor: nw-resize;
}


