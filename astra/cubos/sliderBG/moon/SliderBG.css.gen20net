.bg-slider {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
    background: #0b0b0c;
}

.bg-slider__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transform: scale(1.05);
    transition: opacity 1.4s ease-in-out;
    will-change: opacity, transform;
}

.bg-slider__img.is-active {
    opacity: 1;
}

/* Ken Burns: αργό zoom μόνο στο ενεργό */
.bg-slider.has-kenburns .bg-slider__img {
    transform: scale(1.05);
}

.bg-slider.has-kenburns .bg-slider__img.is-active {
    animation: bg-kenburns 14s ease-out forwards;
}

@keyframes bg-kenburns {
    from { transform: scale(1.05); }
    to   { transform: scale(1.15); }
}

/* Σκούρο overlay για αναγνωσιμότητα */
.bg-slider__overlay {
    position: absolute;
    inset: 0;
    background: #000;
    transition: opacity 0.4s ease;
    pointer-events: none;
}

/* Απαλό vignette (σκοτεινές γωνίες) */
.bg-slider__vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(
            ellipse at center,
            rgba(0, 0, 0, 0) 45%,
            rgba(0, 0, 0, 0.45) 100%
    );
    pointer-events: none;
}

/* Dots */
.bg-slider__dots {
    position: absolute;
    right: 24px;
    bottom: 24px;
    display: flex;
    gap: 10px;
    pointer-events: auto;
}

.bg-slider__dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    border: 0;
    padding: 0;
    background: rgba(255, 255, 255, 0.45);
    cursor: pointer;
    transition: background 0.25s ease, transform 0.25s ease, width 0.25s ease;
}

.bg-slider__dot:hover {
    background: rgba(255, 255, 255, 0.75);
}

.bg-slider__dot.is-active {
    background: #fff;
    width: 26px;
    transform: scale(1);
}

/* Προσβασιμότητα: χωρίς κίνηση */
@media (prefers-reduced-motion: reduce) {
    .bg-slider__img {
        transition: opacity 0.6s ease;
        transform: none;
    }
    .bg-slider.has-kenburns .bg-slider__img.is-active {
        animation: none;
        transform: none;
    }
}