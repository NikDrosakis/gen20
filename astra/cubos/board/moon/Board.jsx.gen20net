import './Board.css';

const Board = () => {
    return (
        <section className="spad">
            <div className="container">
                <div className="board-card">
                    {/* Image section */}
                    <div className="board-image">
                        <img
                            src="/img/akroasi1.jpg"
                            alt="Ακρόαση Ηθοποιών - Πρώτη Γνωριμία"
                        />
                    </div>

                    {/* Text content section */}
                    <div className="board-text">
                        <h2 className="board-title">
                            📢{' '}
                            <a
                                href="https://www.facebook.com/events/608066588465451/"
                                className="board-link"
                                target="_blank"
                                rel="noreferrer"
                            >
                                Facebook Event
                            </a>
                        </h2>
                        <p className="board-body">
                            Για επαγγελματική θεατρική παράσταση σε περιοδεία, θα πραγματοποιηθεί
                            πρώτη γνωριμία & ακρόαση με τον Νικόλα Δροσάκη, την Παρασκευή 27 Ιουνίου
                            2025 στις 20:00, στον:
                            <br />
                            📍 Λαχανά 12, Ηράκλειο Κρήτης
                            <br />
                            🔸 Αφορά απόφοιτους δραματικής σχολής και έμπειρους ηθοποιούς (άνδρες,
                            γυναίκες)
                            <br />
                            🔸 Δεν απαιτείται προετοιμασμένο υλικό
                            <br />
                            🔸 Ελεύθερη προσέλευση – απλώς δήλωσε "Going" στο fb event
                            <br />
                            📩 Δήλωση συμμετοχής / ερωτήσεις:
                            <br />
                            ✉️ info@gen20.net
                            <br />
                            📱 MP: facebook.com/nikdrosakis
                        </p>
                    </div>
                </div>
            </div>
        </section>
    );
};

export default Board;