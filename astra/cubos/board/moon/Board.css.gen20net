.board-card {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    background: #f3f4f6; /* gray-100 */
    padding: 1.5rem;
    border-radius: 0.5rem;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
}

.board-image {
    width: 33.333%;
    flex-shrink: 0;
}

.board-image img {
    width: 100%;
    height: auto;
    border-radius: 0.25rem;
    display: block;
}

.board-text {
    width: 66.667%;
}

.board-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1f2937; /* gray-800 */
    margin: 0 0 0.5rem;
}

.board-link {
    color: #2563eb; /* blue-600 */
    text-decoration: underline;
}

.board-link:hover {
    color: #1e40af; /* blue-800 */
}

.board-body {
    color: #374151; /* gray-700 */
    font-size: 1rem;
    line-height: 1.625;
    margin: 0;
}

/* Responsive: σε μικρές οθόνες στοίβαξη */
@media (max-width: 768px) {
    .board-card {
        flex-direction: column;
        align-items: stretch;
    }
    .board-image,
    .board-text {
        width: 100%;
    }
}