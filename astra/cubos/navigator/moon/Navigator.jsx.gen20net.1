import './Navigator.css';

export default function Navigator({ prevPost, nextPost }) {
    return (
        <nav className="navigator" aria-label="Post navigation">
            <div className="navigator__row">
                <a
                    href={prevPost?.link || '/'}
                    className="navigator__item navigator__item--prev"
                    aria-label={prevPost?.title ? `Previous: ${prevPost.title}` : 'Previous post'}
                >
                    <h5 className="navigator__heading">
                        <i className="fa fa-angle-left" aria-hidden="true" /> Previous post
                    </h5>
                    <div className="navigator__img">
                        <img src={prevPost?.image || '/img/blog/prev.jpg'} alt="" />
                    </div>
                    <div className="navigator__text">
                        <h6>{prevPost?.title || 'No previous post'}</h6>
                        <span>{prevPost?.date || '—'}</span>
                    </div>
                </a>

                <a
                    href={nextPost?.link || '/'}
                    className="navigator__item navigator__item--next"
                    aria-label={nextPost?.title ? `Next: ${nextPost.title}` : 'Next post'}
                >
                    <h5 className="navigator__heading">
                        Next post <i className="fa fa-angle-right" aria-hidden="true" />
                    </h5>
                    <div className="navigator__img">
                        <img src={nextPost?.image || '/img/blog/next.jpg'} alt="" />
                    </div>
                    <div className="navigator__text">
                        <h6>{nextPost?.title || 'No next post'}</h6>
                        <span>{nextPost?.date || '—'}</span>
                    </div>
                </a>
            </div>
        </nav>
    );
}